<?xml version="1.0" encoding="utf-8"?>
<!-- A TV with a colored LED halo and a camera lens on its screen. Kept inside the 66 dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- LED halo -->
    <path
        android:pathData="M30,36 H78 A6,6 0 0 1 84,42 V66 A6,6 0 0 1 78,72 H30 A6,6 0 0 1 24,66 V42 A6,6 0 0 1 30,36 Z"
        android:strokeWidth="3.4"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="24"
                android:startY="36"
                android:endX="84"
                android:endY="72">
                <item android:offset="0" android:color="#FFFF3D9A" />
                <item android:offset="0.5" android:color="#FFFFC400" />
                <item android:offset="1" android:color="#FF00E5FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Screen -->
    <path
        android:fillColor="#FF22202C"
        android:pathData="M32.5,40.25 H75.5 A3,3 0 0 1 78.5,43.25 V64.75 A3,3 0 0 1 75.5,67.75 H32.5 A3,3 0 0 1 29.5,64.75 V43.25 A3,3 0 0 1 32.5,40.25 Z" />

    <!-- Camera lens -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,45.5 A8.5,8.5 0 1 1 54,62.5 A8.5,8.5 0 1 1 54,45.5 Z"
        android:strokeColor="#FFECE9F4"
        android:strokeWidth="2.2" />
    <path android:pathData="M54,48.8 A5.2,5.2 0 1 1 54,59.2 A5.2,5.2 0 1 1 54,48.8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="5.2">
                <item android:offset="0" android:color="#FF00E5FF" />
                <item android:offset="1" android:color="#FF7C4DFF" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#E6FFFFFF"
        android:pathData="M52,50.7 A1.3,1.3 0 1 1 52,53.3 A1.3,1.3 0 1 1 52,50.7 Z" />

    <!-- Stand -->
    <path
        android:pathData="M47,77 H61"
        android:strokeColor="#FFA29FB2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
</vector>
